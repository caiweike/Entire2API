# Node 24+, default listener is loopback.
HOST=127.0.0.1
PORT=8080
# Default config and API key are generated locally by npm run configure.
# ENTIRE2API_CONFIG=.local/config.json
# GATEWAY_KEY_FILE=.local/gateway-key.txt
# STATE_DIR=.local/state

# Credentials: ENTIRE_TOKEN > ENTIRE_TOKEN_FILE > official CLI.
# Prefer CLI on a persistent workstation; it refreshes its own login.
# ENTIRE_CLI=C:/absolute/path/to/entire.exe
# ENTIRE_CONFIG_DIR=C:/absolute/path/to/Entire2API/.local/entire
# ENTIRE_TOKEN_FILE=C:/absolute/path/to/private/token.txt

# MCP overrides belong in your Agent client's MCP env, not this gateway file:
# ENTIRE2API_URL=http://127.0.0.1:8080
# ENTIRE2API_KEY_FILE=C:/absolute/path/to/private/gateway-key.txt
# ENTIRE2API_MODEL=entire-codex
